# Copy to .env for local use. Production deployments must use a secret manager.
ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./careerbridge.db
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Google OAuth web client; callback must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Gemini structured resume extraction and personalized roadmap guidance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Adzuna India job search.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=20

# S3-compatible private resume storage (local development uses .tmp/resumes).
S3_BUCKET=
AWS_REGION=ap-south-1
S3_ENDPOINT_URL=
RESUME_MAX_BYTES=10485760
