# CareerBridge Environment Variables Template
# Copy this file to .env and populate with your real keys

# Application Environment
ENV=development

# LLM / AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Google OAuth Credentials (if integrating Google Sheets, Slides, Drive)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Database / Storage (if applicable)
DATABASE_URL=
