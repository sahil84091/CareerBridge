# Database Configuration
# Defaults to SQLite for zero-config hackathon execution. Set to PostgreSQL URI if running Postgres:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/careerbridge
DATABASE_URL=sqlite:///./careerbridge.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI API Key (Gemini or OpenAI). System includes robust heuristic fallback for offline/instant evaluation.
GEMINI_API_KEY=
OPENAI_API_KEY=
